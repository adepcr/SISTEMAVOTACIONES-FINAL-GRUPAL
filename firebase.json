{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": "www",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "**/*.@(html|js|css|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "descargas/*.apk", "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"ADEP-Vota.apk\"" }
      ] }
    ]
  },
  "emulators": { "auth": { "port": 9099 }, "firestore": { "port": 8080 }, "ui": { "enabled": false } }
}
